@model ClinicManagementSystem.ViewModels.RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Register";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MedSteps Clinic</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            .auth-wrapper {
                min-height: 100vh;
                display: flex;
                overflow: hidden;
            }

            .auth-brand-panel {
                position: relative;
                flex: 1;
                display: flex;
                flex-direction: column;
                justify-content: center;
                padding: 4rem 3.5rem;
                color: #fff;
                background: linear-gradient(135deg, #06294d 0%, #0b5ea8 55%, #159bd8 100%);
                overflow: hidden;
            }

                .auth-brand-panel::before, .auth-brand-panel::after {
                    content: "";
                    position: absolute;
                    border-radius: 50%;
                    background: rgba(255, 255, 255, 0.08);
                }

                .auth-brand-panel::before {
                    width: 420px;
                    height: 420px;
                    top: -140px;
                    right: -140px;
                }

                .auth-brand-panel::after {
                    width: 280px;
                    height: 280px;
                    bottom: -100px;
                    left: -80px;
                    background: rgba(255, 255, 255, 0.06);
                }

            .auth-brand-icon {
                width: 64px;
                height: 64px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(255, 255, 255, 0.15);
                border-radius: 18px;
                margin-bottom: 2rem;
                backdrop-filter: blur(6px);
            }

            .auth-brand-panel h1 {
                font-weight: 800;
                font-size: 2.4rem;
                line-height: 1.25;
                position: relative;
                z-index: 2;
            }

            .auth-brand-panel p.lead-text {
                color: rgba(255, 255, 255, 0.85);
                font-size: 1.05rem;
                max-width: 420px;
                position: relative;
                z-index: 2;
            }

            .auth-feature-list {
                list-style: none;
                padding: 0;
                margin: 2rem 0 0;
                position: relative;
                z-index: 2;
            }

                .auth-feature-list li {
                    display: flex;
                    align-items: center;
                    gap: .75rem;
                    margin-bottom: 1rem;
                    font-weight: 500;
                }

                    .auth-feature-list li i {
                        width: 34px;
                        height: 34px;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        background: rgba(255, 255, 255, 0.18);
                        border-radius: 50%;
                        flex-shrink: 0;
                    }

            .auth-stat-badge {
                position: absolute;
                bottom: 2.5rem;
                left: 3.5rem;
                z-index: 3;
                background: rgba(255, 255, 255, 0.95);
                color: #06294d;
                border-radius: 16px;
                padding: 1rem 1.4rem;
                display: flex;
                align-items: center;
                gap: .8rem;
                box-shadow: 0 15px 35px rgba(0, 0, 0, 0.25);
            }

                .auth-stat-badge .num {
                    font-weight: 800;
                    font-size: 1.3rem;
                    line-height: 1;
                }

            .auth-form-panel {
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 3rem 2rem;
                background: #f4f7fa;
                position: relative;
            }

            .auth-card {
                width: 100%;
                max-width: 580px;
                background: rgba(255, 255, 255, 0.85);
                backdrop-filter: blur(14px);
                border: 1px solid rgba(255, 255, 255, 0.6);
                border-radius: 24px;
                padding: 2.75rem;
                box-shadow: 0 25px 60px rgba(11, 94, 168, 0.15);
            }

                .auth-card .form-control, .auth-card .input-group-text {
                    background: #fff;
                }

                .auth-card .btn-gradient {
                    background: linear-gradient(135deg, #0b5ea8, #159bd8);
                    border: none;
                    color: #fff;
                    transition: transform .2s ease, box-shadow .2s ease;
                }

                    .auth-card .btn-gradient:hover {
                        transform: translateY(-2px);
                        box-shadow: 0 12px 25px rgba(11, 94, 168, 0.35);
                        color: #fff;
                    }

            @@media (max-width: 991.98px) {
                .auth-brand-panel {
                    display: none;
                }

                .auth-form-panel {
                    flex: 1 1 100%;
                }
            }
    </style>
</head>
<body>
    <div class="auth-wrapper">
        <div class="auth-brand-panel">
            <div class="auth-brand-icon">
                <i class="bi bi-heart-pulse-fill" style="font-size: 1.8rem;"></i>
            </div>
            <h1>Start Your Health Journey With MedSteps</h1>
            <p class="lead-text">Create your free account and get instant access to online booking, digital medical records, and 24/7 support from our specialists.</p>
            <ul class="auth-feature-list">
                <li><i class="bi bi-calendar2-check"></i> Book appointments in seconds</li>
                <li><i class="bi bi-file-earmark-medical"></i> Access your medical history anytime</li>
                <li><i class="bi bi-shield-check"></i> Your data is private & secure</li>
            </ul>
            <div class="auth-stat-badge">
                <i class="bi bi-people-fill fs-4"></i>
                <div>
                    <div class="num">10,000+</div>
                    <div class="small">Happy Patients</div>
                </div>
            </div>
        </div>

        <div class="auth-form-panel">
            <div class="auth-card">
                <div class="text-center mb-4">
                    <i class="bi bi-person-plus-fill text-primary mb-2" style="font-size: 2.6rem;"></i>
                    <h3 class="fw-bold mb-1">Create an Account</h3>
                    <p class="text-muted small mb-0">Join MedSteps Clinic today</p>
                </div>

                <form asp-controller="Account" asp-action="Register" method="post">

                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-bold"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-bold small text-muted">First Name</label>
                            <input asp-for="FirstName" class="form-control rounded-pill px-4 py-2" placeholder="John">
                            <span asp-validation-for="FirstName" class="text-danger small fw-bold"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-bold small text-muted">Last Name</label>
                            <input asp-for="LastName" class="form-control rounded-pill px-4 py-2" placeholder="Doe">
                            <span asp-validation-for="LastName" class="text-danger small fw-bold"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-bold small text-muted">Email</label>
                            <div class="input-group">
                                <span class="input-group-text rounded-start-pill border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                <input asp-for="Email" class="form-control rounded-end-pill border-start-0 px-3 py-2" placeholder="name@example.com">
                            </div>
                            <span asp-validation-for="Email" class="text-danger small fw-bold"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-bold small text-muted">Phone <small class="text-success fw-normal">(WhatsApp available)</small></label>
                            <div class="input-group">
                                <span class="input-group-text rounded-start-pill border-end-0"><i class="bi bi-whatsapp text-success"></i></span>
                                <input asp-for="PhoneNumber" class="form-control rounded-end-pill border-start-0 px-3 py-2" placeholder="01xxxxxxxxx">
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small fw-bold"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-bold small text-muted">Password</label>
                            <div class="input-group">
                                <span class="input-group-text rounded-start-pill border-end-0"><i class="bi bi-lock text-muted"></i></span>

                                <input asp-for="Password" value="@Model?.Password" class="form-control border-start-0 px-3 py-2" placeholder="********" id="passwordInput">

                                <span class="input-group-text rounded-end-pill border-start-0 toggle-password" role="button" data-target="passwordInput">
                                    <i class="bi bi-eye-slash text-muted"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small fw-bold"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold small text-muted">Confirm Password</label>
                            <div class="input-group">
                                <span class="input-group-text rounded-start-pill border-end-0"><i class="bi bi-lock-fill text-muted"></i></span>

                                <input asp-for="ConfirmPassword" value="@Model?.ConfirmPassword" class="form-control border-start-0 px-3 py-2" placeholder="********" id="confirmPasswordInput">

                                <span class="input-group-text rounded-end-pill border-start-0 toggle-password" role="button" data-target="confirmPasswordInput">
                                    <i class="bi bi-eye-slash text-muted"></i>
                                </span>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small fw-bold"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-gradient w-100 rounded-pill py-2 fw-bold mb-3">
                        Register <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                    <div class="text-center text-muted small">
                        Already have an account? <a asp-controller="Account" asp-action="Login" class="fw-bold text-decoration-none">Login here</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
            document.querySelectorAll('.toggle-password').forEach(function (el) {
                el.addEventListener('click', function () {
                    var input = document.getElementById(this.dataset.target);
                    var icon = this.querySelector('i');
                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.classList.replace('bi-eye-slash', 'bi-eye');
                    } else {
                        input.type = 'password';
                        icon.classList.replace('bi-eye', 'bi-eye-slash');
                    }
                });
            });
    </script>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>