@model ClinicManagementSystem.Models.ContactMessage
@{
    ViewData["Title"] = "Contact Us";
}

<div class="page-title pt-5 mt-5">
    <div class="heading">
        <div class="container">
            <div class="row d-flex justify-content-center text-center">
                <div class="col-lg-8">
                    <h1 class="heading-title text-primary fw-bold">Contact Us</h1>
                    <p class="mb-0 text-muted">
                        We are here to assist you. Reach out to MedSteps Clinic for inquiries, support, or to schedule an appointment.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<section id="contact" class="contact section py-5">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row g-5">
            <div class="col-lg-5">
                <div class="d-flex flex-column gap-4">
                    <div class="card border-0 shadow-sm p-4 rounded-4 text-center" data-aos="fade-up" data-aos-delay="100">
                        <i class="bi bi-geo-alt text-primary fs-2 mb-2"></i>
                        <h4 class="fw-bold">Our Address</h4>
                        <p class="text-muted mb-0">123 MedSteps Avenue, Obour City, Egypt</p>
                    </div>
                    <div class="card border-0 shadow-sm p-4 rounded-4 text-center" data-aos="fade-up" data-aos-delay="200">
                        <i class="bi bi-envelope text-primary fs-2 mb-2"></i>
                        <h4 class="fw-bold">Email Address</h4>
                        <p class="text-muted mb-0">info@medstepsclinic.com</p>
                    </div>
                    <div class="card border-0 shadow-sm p-4 rounded-4 text-center" data-aos="fade-up" data-aos-delay="300">
                        <i class="bi bi-headset text-primary fs-2 mb-2"></i>
                        <h4 class="fw-bold">Hours of Operation</h4>
                        <p class="text-muted mb-0">Sat-Thu: 9 AM - 10 PM<br>Friday: Emergency Only</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card border-0 shadow-sm p-5 rounded-4 h-100" data-aos="fade-up" data-aos-delay="200">
                    <h3 class="fw-bold mb-3">Send us a Message</h3>
                    <p class="text-muted mb-4">Have questions? Reach out to us and our team will get back to you shortly.</p>

                    <form asp-controller="Home" asp-action="Contact" method="post">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <input type="text" asp-for="Name" class="form-control rounded-pill px-3" placeholder="Your Name" required>
                            </div>
                            <div class="col-md-6">
                                <input type="email" asp-for="Email" class="form-control rounded-pill px-3" placeholder="Your Email" required>
                            </div>
                            <div class="col-12">
                                <input type="text" asp-for="Subject" class="form-control rounded-pill px-3" placeholder="Subject" required>
                            </div>
                            <div class="col-12">
                                <textarea asp-for="Message" class="form-control rounded-4 px-3" rows="5" placeholder="Your Message" required></textarea>
                            </div>
                            <div class="col-12 text-center mt-4">
                                <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold">Send Message <i class="bi bi-send ms-1"></i></button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="container-fluid mt-5 rounded-4 overflow-hidden shadow-sm p-0" data-aos="fade-up" data-aos-delay="200">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3449.600109968846!2d31.4583196!3d30.1633519!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzDCsDA5JzQ4LjEiTiAzMcKwMjcnMjkuOSJF!5e0!3m2!1sen!2seg!4v1620000000000!5m2!1sen!2seg" width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
        </div>
    </div>
</section>