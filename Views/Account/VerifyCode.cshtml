@{
    Layout = "_Layout";
    ViewData["Title"] = "Verify Email";
}

<div class="container mt-5 pt-5 mb-5">
    <div class="row justify-content-center mt-4">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4 p-4 text-center">
                <div class="card-body">
                    <i class="bi bi-envelope-check text-primary mb-3" style="font-size: 4rem;"></i>
                    <h3 class="fw-bold mb-2">Check Your Email</h3>
                    <p class="text-muted mb-4">
                        We've sent a 6-digit verification code to <br />
                        <strong>@ViewBag.Email</strong>
                    </p>

                    <form asp-action="VerifyCode" method="post">
                        <input type="hidden" name="email" value="@ViewBag.Email" />

                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 fw-bold"></div>

                        <div class="mb-4">
                            <input type="text" name="code" class="form-control form-control-lg text-center rounded-pill fw-bold"
                                   placeholder="Enter 6-digit code" maxlength="6" autocomplete="off" required
                                   style="letter-spacing: 8px; font-size: 1.5rem;" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm" style="background: linear-gradient(135deg, #0b5ea8, #159bd8); border: none;">
                            Verify & Continue <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>