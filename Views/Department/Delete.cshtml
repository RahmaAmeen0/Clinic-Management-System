@model ClinicManagementSystem.Models.Department

@{
    ViewData["Title"] = "Delete Department";
}

<section class="py-5 mt-5">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-7">

                <div class="card border-0 shadow-lg rounded-4 border-danger">

                    <div class="card-body p-5">

                        <div class="text-center mb-5">

                            <h2 class="fw-bold text-danger">
                                Delete Department
                            </h2>

                            <p class="text-muted">
                                Are you sure you want to delete this department?
                            </p>

                        </div>

                        <div class="alert alert-danger rounded-3">

                            <strong>Warning:</strong>
                            This action cannot be undone.

                        </div>

                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                Department Name
                            </label>

                            <div class="form-control form-control-lg rounded-3 bg-light">
                                @Model.Type
                            </div>

                        </div>

                        <div class="mb-4">

                            <label class="form-label fw-bold">
                                Description
                            </label>

                            <div class="form-control rounded-3 bg-light"
                                 style="min-height:120px">

                                @Model.Description

                            </div>

                        </div>

                        <form asp-action="Delete">

                            <input type="hidden" asp-for="Id" />

                            <div class="d-flex justify-content-between">

                                <a asp-action="Index"
                                   class="btn btn-outline-secondary px-4">
                                    Cancel
                                </a>

                                <button type="submit"
                                        class="btn btn-danger px-5">

                                    <i class="bi bi-trash me-2"></i>
                                    Delete

                                </button>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>