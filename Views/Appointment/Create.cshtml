@model ClinicManagementSystem.ViewModels.AppointmentViewModel

@{
    // السطر ده بيقول للصفحة دي إنها تستخدم الـ Layout الأساسي بتاع الموقع
    ViewData["Title"] = "Book Appointment";
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css" />

<style>
    .iti { width: 100%; }
</style>
}

<div class="page-title mt-5 pt-5">
    <div class="heading">
        <div class="container">
            <div class="row d-flex justify-content-center text-center">
                <div class="col-lg-8">
                    <h1 class="heading-title">Appointment</h1>
                    <p class="mb-0">
                        Book your medical appointment easily. Please fill in your details below to schedule a visit with one of our specialists.
                    </p>
                </div>
            </div>
        </div>
    </div>
    <nav class="breadcrumbs">
        <div class="container">
            <ol>
                <li><a href="/">Home</a></li>
                <li class="current">Appointment</li>
            </ol>
        </div>
    </nav>
</div>

<section id="appointmnet" class="appointmnet section">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="booking-wrapper">
                    <div class="booking-header text-center" data-aos="fade-up" data-aos-delay="200">
                        <h2>Schedule Your Appointment</h2>
                        <p>Book your medical appointment in just a few simple steps. Our experienced healthcare professionals are ready to provide you with the best care possible.</p>
                    </div>

                    <div class="appointment-form" data-aos="fade-up" data-aos-delay="400">
                        <form asp-action="Create" method="post">
                            <div class="row gy-4">
                                <div class="col-12 mb-2">
                            <h5 class="fw-bold mb-3 text-primary">Patient Information</h5>
                          </div>


                             <div class="col-md-12">
    <label class="form-label fw-bold small text-muted">Phone Number <span class="text-danger">*</span></label>
    <input asp-for="Phone" id="phone" class="form-control" type="tel" required>
    <span asp-validation-for="Phone" class="text-danger small"></span>
</div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">First Name <span class="text-danger">*</span></label>
                                    <input asp-for="FirstName" class="form-control" placeholder="First Name" required>
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Last Name <span class="text-danger">*</span></label>
                                    <input asp-for="LastName" class="form-control" placeholder="Last Name" required>
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Age <span class="text-danger">*</span></label>
                                    <input asp-for="Age" class="form-control" placeholder="Age" required>
                                    <span asp-validation-for="Age" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Gender <span class="text-danger">*</span></label>
                                    <select asp-for="Gender" class="form-select" required>
                                        <option value="">Select Gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger small"></span>
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label fw-bold small text-muted">Full Address <span class="text-danger">*</span></label>
                                    <input asp-for="Address" class="form-control" placeholder="City, Street, Building..." required>
                                    <span asp-validation-for="Address" class="text-danger small"></span>
                                </div>

                                <div class="col-12 mt-4">
                                    <hr>
                                    <h5 class="fw-bold mb-3 text-primary">Appointment Details</h5>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Department <span class="text-danger">*</span></label>
                                    <select asp-for="DepartmentId" asp-items="Model.DepartmentsList" class="form-select" required>
                                        <option value="">Select Department</option>
                                    </select>
                                    <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Doctor <span class="text-danger">*</span></label>
                                    <select asp-for="DoctorId" asp-items="Model.DoctorsList" class="form-select" required>
                                        <option value="">-- Select Doctor --</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Schedule <span class="text-danger">*</span></label>
                                    <select asp-for="ScheduleId" asp-items="Model.SchedulesList" class="form-select" required>
                                        <option value="">-- Select Schedule --</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Visit Type <span class="text-danger">*</span></label>
                                    <select asp-for="VisitType" class="form-select" required>
                                        <option value="">Select Visit Type</option>
                                        <option value="New Consultation">New Consultation</option>
                                        <option value="Follow-up">Follow-up</option>
                                    </select>
                                    <span asp-validation-for="VisitType" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold small text-muted">Additional Notes</label>
                                    <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Any symptoms or notes for the doctor (optional)"></textarea>
                                    <span asp-validation-for="Notes" class="text-danger small"></span>
                                </div>

                                <div class="col-12 mt-4 text-center">
                                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold">Book Appointment Now</button>
                                </div>

                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const phoneInputField = document.querySelector("#phone");
        
        // تشغيل المكتبة
        const phoneInput = window.intlTelInput(phoneInputField, {
            initialCountry: "eg", // خلينا مصر هي الافتراضي
            preferredCountries: ["eg", "sa", "ae", "kw", "qa"], // دول الخليج ومصر يظهروا في أول القائمة
            utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js",
        });

        // الحركة دي مهمة: قبل ما الفورم تتبعت، بناخد الرقم المدمج (الكود + الرقم) ونحطه في الخانة
        const form = document.querySelector("form");
        form.addEventListener("submit", function() {
            if (phoneInputField.value.trim() !== "") {
                phoneInputField.value = phoneInput.getNumber(); 
            }
        });
    });
</script>