@model ClinicManagementSystem.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home Page";
}

<style>
    .doctor-card-hover:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 30px rgba(13, 110, 253, 0.15) !important;
    }

    .dept-card-hover:hover {
        transform: translateY(-5px);
        border-color: #0d6efd !important;
        box-shadow: 0 10px 25px rgba(13, 110, 253, 0.1) !important;
    }
</style>

<section id="hero" class="hero section">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="hero-content">
                    <div class="trust-badges mb-4" data-aos="fade-right" data-aos-delay="200">
                        <div class="badge-item">
                            <i class="bi bi-shield-check"></i>
                            <span>Accredited</span>
                        </div>
                        <div class="badge-item">
                            <i class="bi bi-clock"></i>
                            <span>24/7 Support</span>
                        </div>
                        <div class="badge-item">
                            <i class="bi bi-star-fill"></i>
                            <span>Top Rated</span>
                        </div>
                    </div>

                    <h1 data-aos="fade-right" data-aos-delay="300">
                        Excellence in <span class="highlight">Healthcare</span> With Compassionate Care
                    </h1>

                    <p class="hero-description" data-aos="fade-right" data-aos-delay="400">
                        Welcome to MedSteps Clinic. We provide exceptional healthcare that combines cutting-edge medical technology with the personal touch our patients deserve.
                    </p>

                    <div class="hero-actions" data-aos="fade-right" data-aos-delay="600">
                        <a asp-controller="Appointment" asp-action="Create" class="btn btn-primary">Book Appointment</a>
                        <a asp-controller="Department" asp-action="Index" class="btn btn-outline ms-3">
                            Explore Departments
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-visual" data-aos="fade-left" data-aos-delay="400">
                    <div class="main-image">
                        <img src="/assets/img/health/staff-10.webp" alt="MedSteps Healthcare Facility" class="img-fluid rounded-4 shadow-lg">

                        <div class="floating-card appointment-card">
                            <div class="card-icon">
                                <i class="bi bi-calendar-check text-primary"></i>
                            </div>
                            <div class="card-content">
                                <h6>Easy Booking</h6>
                                <small>Schedule online 24/7</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="home-about" class="home-about section bg-light py-5">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-5 mb-lg-0" data-aos="fade-right" data-aos-delay="200">
                <div class="about-content">
                    <h2 class="section-heading text-primary fw-bold mb-4">Compassionate Care, Advanced Medicine</h2>
                    <p class="lead text-muted">We maintain the highest standards of medical excellence while fostering an environment of trust and healing.</p>

                    <div class="stats-grid mt-4 d-flex gap-4">
                        <div class="stat-item text-center">
                            <div class="stat-number purecounter fs-1 text-primary fw-bold" data-purecounter-start="0" data-purecounter-end="5000" data-purecounter-duration="2">5000+</div>
                            <div class="stat-label text-muted">Patients Served</div>
                        </div>
                        <div class="stat-item text-center">
                            <div class="stat-number purecounter fs-1 text-primary fw-bold" data-purecounter-start="0" data-purecounter-end="15" data-purecounter-duration="2">15+</div>
                            <div class="stat-label text-muted">Years of Excellence</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6" data-aos="fade-left" data-aos-delay="300">
                <div class="about-visual text-center">
                    <img src="/assets/img/health/facilities-9.webp" alt="Modern medical facility" class="img-fluid rounded-4 shadow">
                </div>
            </div>
        </div>
    </div>
</section>

<section id="featured-departments" class="featured-departments section py-5">
    <div class="container text-center mb-5" data-aos="fade-up">
        <h2 class="fw-bold text-primary">Our Departments</h2>
        <p class="text-muted">Comprehensive medical specialties tailored for your needs.</p>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row g-4 justify-content-center">
            @if (Model.Departments != null && Model.Departments.Any())
            {
                foreach (var dept in Model.Departments)
                {
                    // 1. سحر الأيقونات: بنقرأ اسم القسم ونديله الأيقونة المناسبة ليه
                    string iconClass = "fas fa-clinic-medical"; // الأيقونة الافتراضية
                    string deptName = dept.Type.ToLower();

                    if (deptName.Contains("dent")) { iconClass = "fas fa-tooth"; }
                    else if (deptName.Contains("ortho")) { iconClass = "fas fa-bone"; }
                    else if (deptName.Contains("pediatric")) { iconClass = "fas fa-baby"; }
                    else if (deptName.Contains("gynecology") || deptName.Contains("obstetrics")) { iconClass = "fas fa-female"; }
                    else if (deptName.Contains("surgery")) { iconClass = "fas fa-syringe"; } // أو fa-scalpel
                    else if (deptName.Contains("general") || deptName.Contains("medicine") || deptName.Contains("باطنة")) { iconClass = "fas fa-stethoscope"; }
                    else if (deptName.Contains("cardio")) { iconClass = "fas fa-heartbeat"; }
                    else if (deptName.Contains("neuro")) { iconClass = "fas fa-brain"; }

                    <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                        <div class="card h-100 p-4 border rounded-4 shadow-sm bg-white text-center dept-card-hover" style="transition: 0.3s;">
                            <div class="card-body d-flex flex-column align-items-center">

                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mb-4" style="width: 70px; height: 70px;">
                                    <i class="@iconClass fs-3"></i>
                                </div>

                                <h4 class="fw-bold text-dark mb-3">@dept.Type</h4>
                                <p class="text-muted small mb-4">Specialized medical care and advanced treatment protocols.</p>

                                <div class="mt-auto w-100">
                                    <a asp-controller="DoctorSchedules" asp-action="PatientView" asp-route-departmentId="@dept.Id" class="btn btn-outline-primary rounded-pill w-100 fw-bold">
                                        <i class="fas fa-user-md me-2"></i> View Doctors
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning text-center w-100">No departments available right now.</div>
            }
        </div>
    </div>
</section>

<section id="find-a-doctor" class="find-a-doctor section bg-light py-5">
    <div class="container text-center mb-5" data-aos="fade-up">
        <h2 class="fw-bold text-primary">Meet Our Doctors</h2>
        <p class="text-muted">A highly skilled team of medical professionals dedicated to your health.</p>
    </div>

    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row g-4 justify-content-center">
            @if (Model.Doctors != null && Model.Doctors.Any())
            {
                foreach (var doc in Model.Doctors)
                {
                    <div class="col-lg-4 col-md-6" data-aos="zoom-in" data-aos-delay="100">
                        <div class="card h-100 border-0 shadow-sm rounded-4 text-center doctor-card-hover" style="transition: transform 0.3s ease, box-shadow 0.3s ease;">
                            <div class="card-body p-4 d-flex flex-column align-items-center">

                                <div class="mb-4">
                                    <img src="~/assets/img/Doctors/@doc.image"
                                         alt="Dr. @doc.FirstName"
                                         class="img-fluid rounded-circle border border-3 border-primary shadow-sm"
                                         style="width: 150px; height: 150px; object-fit: cover;"
                                         onerror="this.src='https://cdn-icons-png.flaticon.com/512/3774/3774299.png'">
                                </div>

                                <h4 class="card-title fw-bold text-dark mb-2">Dr. @doc.FirstName @doc.LastName</h4>
                                <div class="mb-4">
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fs-6">@doc.Specialization</span>
                                </div>

                                <div class="mt-auto w-100">
                                    <a asp-controller="DoctorSchedules" asp-action="PatientView" asp-route-doctorId="@doc.DoctorId" class="btn btn-outline-primary rounded-pill w-100 fw-bold">
                                        <i class="far fa-calendar-alt me-1"></i> View Schedule
                                    </a>
                                </div>

                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-info text-center w-100">No doctors listed at the moment.</div>
            }
        </div>

        <div class="text-center mt-5" data-aos="fade-up" data-aos-delay="400">
            <a asp-controller="Doctors" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                View All Doctors <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

<section id="call-to-action" class="call-to-action section py-5">
    <div class="container" data-aos="zoom-in" data-aos-delay="100">
        <div class="bg-primary text-white rounded-4 p-5 text-center shadow">
            <h2 class="fw-bold mb-3">Need Immediate Medical Assistance?</h2>
            <p class="mb-4 fs-5 text-white-50">Our emergency response team is available around the clock to provide immediate medical support when you need it most.</p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Appointment" asp-action="Create" class="btn btn-light text-primary btn-lg rounded-pill px-5 fw-bold shadow-sm">
                    Schedule Consultation
                </a>
                <a href="tel:5551234567" class="btn btn-outline-light btn-lg rounded-pill px-5 fw-bold">
                    <i class="bi bi-telephone me-2"></i> (555) 123-4567
                </a>
            </div>
        </div>
    </div>
</section>