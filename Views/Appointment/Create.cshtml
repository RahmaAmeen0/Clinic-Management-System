@model ClinicManagementSystem.ViewModels.AppointmentViewModel

@{
    // السطر ده بيقول للصفحة دي إنها تستخدم الـ Layout الأساسي بتاع الموقع
    ViewData["Title"] = "Book Appointment";
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/css/intlTelInput.css" />

    <style>
        .iti {
            width: 100%;
        }
    </style>
}

<div class="page-title mt-5 pt-5">
    <div class="heading">
        <div class="container">
            <div class="row d-flex justify-content-center text-center">
                <div class="col-lg-8">
                    <h1 class="heading-title">Appointment</h1>
                    <p class="mb-0">
                        Book your medical appointment easily. Please fill in your details below to schedule a visit with one of our specialists.
                    </p>
                </div>
            </div>
        </div>
    </div>
    <nav class="breadcrumbs">
        <div class="container">
            <ol>
                <li><a href="/">Home</a></li>
                <li class="current">Appointment</li>
            </ol>
        </div>
    </nav>
</div>

<section id="appointmnet" class="appointmnet section">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <div class="booking-wrapper">
                    <div class="booking-header text-center" data-aos="fade-up" data-aos-delay="200">
                        <h2>Schedule Your Appointment</h2>
                        <p>Book your medical appointment in just a few simple steps. Our experienced healthcare professionals are ready to provide you with the best care possible.</p>
                    </div>

                    <div class="appointment-form" data-aos="fade-up" data-aos-delay="400">
                        <form asp-action="Create" method="post">
                            <div class="row gy-4">
                                <div class="col-12 mb-2">
                                    <h5 class="fw-bold mb-3 text-primary">Patient Information</h5>
                                </div>


                                <div class="col-md-12">
                                    <label class="form-label fw-bold small text-muted">Phone Number <span class="text-danger">*</span></label>
                                    <input asp-for="Phone" id="phone" class="form-control" type="tel" required>
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">First Name <span class="text-danger">*</span></label>
                                    <input asp-for="FirstName" class="form-control" placeholder="First Name" required>
                                    <span asp-validation-for="FirstName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Last Name <span class="text-danger">*</span></label>
                                    <input asp-for="LastName" class="form-control" placeholder="Last Name" required>
                                    <span asp-validation-for="LastName" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Age <span class="text-danger">*</span></label>
                                    <input asp-for="Age" class="form-control" placeholder="Age" min="1" required>
                                    <span asp-validation-for="Age" class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Gender <span class="text-danger">*</span></label>
                                    <select asp-for="Gender" class="form-select" required>
                                        <option value="">Select Gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger small"></span>
                                </div>

                                <div class="col-md-12">
                                    <label class="form-label fw-bold small text-muted">Full Address <span class="text-danger">*</span></label>
                                    <input asp-for="Address" class="form-control" placeholder="City, Street, Building..." required>
                                    <span asp-validation-for="Address" class="text-danger small"></span>
                                </div>

                                <div class="col-12 mt-4">
                                    <hr>
                                    <h5 class="fw-bold mb-3 text-primary">Appointment Details</h5>
                                </div>

                                <div class="form-group">
                                    <label>Department</label>
                                    <select asp-for="DepartmentId" asp-items="@Model.DepartmentsList" class="form-control" id="DepartmentId">
                                        <option value="">-- please Select Department --</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label>Doctor</label>
                                    <select asp-for="DoctorId" asp-items="@Model.DoctorsList" class="form-control" id="DoctorId">
                                        <option value="">-- Please select a department first --</option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label>Available Schedules</label>
                                    <select asp-for="ScheduleId" asp-items="@Model.SchedulesList" class="form-control" id="ScheduleId">
                                        <option value="">-- Please select a doctor first --</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold small text-muted">Visit Type <span class="text-danger">*</span></label>
                                    <select asp-for="VisitType" class="form-select" required>
                                        <option value="">Select Visit Type</option>
                                        <option value="New Consultation">New Consultation</option>
                                        <option value="Follow-up">Follow-up</option>
                                    </select>
                                    <span asp-validation-for="VisitType" class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold small text-muted">Additional Notes</label>
                                    <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Any symptoms or notes for the doctor (optional)"></textarea>
                                    <span asp-validation-for="Notes" class="text-danger small"></span>
                                </div>

                                <div class="col-12 mt-4 text-center">
                                    <button type="submit" class="btn btn-primary w-100 py-3 rounded-pill fw-bold">Book Appointment Now</button>
                                </div>

                            </div>
                        </form>
                        <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/intlTelInput.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // ==========================================
        // 1. Phone Number Validation Logic
        // ==========================================
        document.addEventListener("DOMContentLoaded", function() {
        const phoneInputField = document.querySelector("#phone");

        // التأكد إن حقل التليفون موجود في الصفحة عشان مايضربش إيرور
        if (phoneInputField) {
        const phoneInput = window.intlTelInput(phoneInputField, {
        initialCountry: "eg",
        preferredCountries: ["eg", "sa", "ae", "kw", "qa"],
        utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js",
        });

        const form = document.querySelector("form");
        form.addEventListener("submit", function(e) {
        if (phoneInputField.value.trim() !== "") {
        if (phoneInput.isValidNumber()) {
        phoneInputField.value = phoneInput.getNumber();
        } else {
        e.preventDefault();
        alert("Please enter a valid international phone number!");
        }
        }
        });
        }
        });

        // ==========================================
        // 2. Cascading Dropdowns Logic (AJAX)
        // ==========================================
        $(document).ready(function() {

        $('#DepartmentId').change(function() {
        var selectedDeptId = $(this).val();
        var doctorSelect = $('#DoctorId');
        var scheduleSelect = $('#ScheduleId');

        doctorSelect.empty().append('<option value="">-- Please select a department first --</option>');
        scheduleSelect.empty().append('<option value="">-- Please select a doctor first --</option>');

        if (selectedDeptId) {
        doctorSelect.empty().append('<option value="">-- Loading doctors... --</option>');

        $.getJSON('/Appointment/GetDoctorsByDepartment', { departmentId: selectedDeptId }, function(data) {
        doctorSelect.empty().append('<option value="">-- Select Doctor --</option>');
        $.each(data, function(index, item) {
        doctorSelect.append('<option value="' + item.id + '">' + item.text + '</option>');
        });
        });
        }
        });

        $('#DoctorId').change(function() {
        var selectedDoctorId = $(this).val();
        var scheduleSelect = $('#ScheduleId');

        scheduleSelect.empty().append('<option value="">-- Please select a doctor first --</option>');

        if (selectedDoctorId) {
        scheduleSelect.empty().append('<option value="">-- Loading available schedules... --</option>');

        $.getJSON('/Appointment/GetSchedulesByDoctor', { doctorId: selectedDoctorId }, function(data) {
        scheduleSelect.empty().append('<option value="">-- Select Available Schedule --</option>');
        $.each(data, function(index, item) {
        scheduleSelect.append('<option value="' + item.id + '">' + item.text + '</option>');
        });
        });
        }
        });

        });
    </script>
}