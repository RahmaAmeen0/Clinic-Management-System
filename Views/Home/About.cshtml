@{
    ViewData["Title"] = "About Us";
}

<div class="page-title pt-5 mt-5">
    <div class="heading">
        <div class="container">
            <div class="row d-flex justify-content-center text-center">
                <div class="col-lg-8">
                    <h1 class="heading-title text-primary fw-bold">About MedSteps Clinic</h1>
                    <p class="mb-0 text-muted">
                        Discover our journey, our values, and the dedicated team working to provide you with the best healthcare experience.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<section id="about" class="about section py-5">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row align-items-center mb-5">
            <div class="col-lg-6" data-aos="fade-right" data-aos-delay="100">
                <div class="about-content">
                    <h2 class="fw-bold mb-4">Compassionate Care for Every Family</h2>
                    <p class="lead text-muted mb-4">For over two decades, we have been dedicated to providing exceptional healthcare services to our community. Our commitment goes beyond medical treatment—we believe in building lasting relationships with our patients.</p>

                    <div class="row text-center mt-4 g-4">
                        <div class="col-md-4">
                            <h2 class="text-primary fw-bold mb-0"><span data-purecounter-start="0" data-purecounter-end="15000" data-purecounter-duration="2" class="purecounter">15000</span>+</h2>
                            <p class="text-muted small">Patients Treated</p>
                        </div>
                        <div class="col-md-4">
                            <h2 class="text-primary fw-bold mb-0"><span data-purecounter-start="0" data-purecounter-end="25" data-purecounter-duration="2" class="purecounter">25</span>+</h2>
                            <p class="text-muted small">Years Experience</p>
                        </div>
                        <div class="col-md-4">
                            <h2 class="text-primary fw-bold mb-0"><span data-purecounter-start="0" data-purecounter-end="50" data-purecounter-duration="2" class="purecounter">50</span>+</h2>
                            <p class="text-muted small">Medical Experts</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 text-center" data-aos="fade-left" data-aos-delay="200">
                <img src="/assets/img/health/facilities-6.webp" class="img-fluid rounded-4 shadow-lg" alt="Healthcare facility">
            </div>
        </div>

        <div class="values-section mt-5 pt-5" data-aos="fade-up" data-aos-delay="300">
            <div class="text-center mb-5">
                <h3 class="fw-bold text-primary">Our Core Values</h3>
                <p class="text-muted">These principles guide everything we do in our commitment to exceptional healthcare</p>
            </div>

            <div class="row g-4 text-center">
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="card h-100 border-0 shadow-sm p-4 rounded-4">
                        <i class="bi bi-heart-pulse text-primary fs-1 mb-3"></i>
                        <h4 class="fw-bold">Compassion</h4>
                        <p class="text-muted small">Providing care with empathy and understanding for every patient.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="card h-100 border-0 shadow-sm p-4 rounded-4">
                        <i class="bi bi-shield-check text-primary fs-1 mb-3"></i>
                        <h4 class="fw-bold">Excellence</h4>
                        <p class="text-muted small">Maintaining the highest standards through continuous learning.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
                    <div class="card h-100 border-0 shadow-sm p-4 rounded-4">
                        <i class="bi bi-people text-primary fs-1 mb-3"></i>
                        <h4 class="fw-bold">Integrity</h4>
                        <p class="text-muted small">Building trust through honest communication and ethical practices.</p>
                    </div>
                </div>
                <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="400">
                    <div class="card h-100 border-0 shadow-sm p-4 rounded-4">
                        <i class="bi bi-lightbulb text-primary fs-1 mb-3"></i>
                        <h4 class="fw-bold">Innovation</h4>
                        <p class="text-muted small">Embracing cutting-edge technology to improve patient outcomes.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>