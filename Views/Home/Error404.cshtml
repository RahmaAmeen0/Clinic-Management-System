@{
    ViewData["Title"] = "Page Not Found";
}

<section id="error-404" class="error-404 section text-center py-5 mt-5 d-flex align-items-center" style="min-height: 70vh;">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <h1 class="display-1 fw-bold text-primary mb-0" style="font-size: 8rem;">404</h1>
                <h2 class="fw-bold mb-3">Page Not Found</h2>
                <p class="text-muted mb-4 lead">
                    The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-bold">
                        <i class="bi bi-house me-2"></i> Back to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>