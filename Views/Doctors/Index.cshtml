@model IEnumerable<ClinicManagementSystem.ViewModels.DoctorsViewModel>

<div class="container mt-5">

    <h2 class="mb-4 text-primary">Doctors</h2>

    <div class="row">

        @foreach (var doctor in Model)
        {
            <div class="col-md-4 mb-4">

                <div class="card shadow border-0">

                    <div class="card-body text-center">

                        <img src="~/assets/img/Doctors/@doctor.image"
                             class="rounded-circle mb-3 shadow-sm"
                             width="220" height="220"
                             style="object-fit: cover; border: 4px solid #f8f9fa;"
                             alt="Dr. @doctor.FirstName" />

                        <h4 class="mt-3">
                            Dr. @doctor.FirstName @doctor.LastName
                        </h4>

                        <p class="text-muted">
                            @doctor.Specialization
                        </p>

                        <p>
                            Gender : @doctor.DoctorGender
                        </p>

                        <p>
                            Department :
                            @doctor.DepartmentName
                        </p>

                        <a asp-controller="Appointment" asp-action="Create" class="btn btn-primary rounded-pill px-4">
                            Book Appointment
                        </a>

                    </div>

                </div>

            </div>
        }

    </div>

</div>